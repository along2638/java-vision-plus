    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.github.javpower.javavision.JavaVisionApplication</mainClass>
                    <includeSystemScope>true</includeSystemScope>
                    <fork>true</fork>
                </configuration>
            </plugin>
            <!-- 打包时跳过测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <skipTests>true</skipTests>
                    <testFailureIgnore>true</testFailureIgnore>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- 打包方式二：不打包动态库(推荐)-->
                <!--                <excludes>-->
                <!--                    <exclude>**/*.*</exclude>-->
                <!--                </excludes>-->
                <!-- 打包方式一：包含文件夹以及子文件夹下所有资源-->
                <includes>
                    <include>**/*.*</include>
                </includes>
                <!-- 该文件单独走过滤，避免开启全局过滤时对几百 MB 的模型文件做占位符扫描 -->
                <excludes>
                    <exclude>inference-flavor.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>inference-flavor.properties</include>
                </includes>
            </resource>
        </resources>
    </build>

    <!--
      原生库按平台 + 推理产物类型分组：
        - 默认（不传参）    → CPU 版原生库，产物行为与之前完全一致
        - mvn package -Dgpu=true → CUDA 版原生库（cu121），产物具备 GPU 能力
      CPU 侧 profile 上带 <property><name>!gpu</name></property>，
      表示"gpu 属性未定义时才激活"，因此 -Dgpu=true 时两套原生库不会同时进入 classpath
      （同名 torch 动态库只能存在一套，否则 DJL 选到哪个是不确定的）。

      说明：这里只决定"产物能不能用 GPU"。运行时到底用不用，由 InferenceDevice
      在启动阶段结合显卡探测结果决定，见 com.github.javpower.javavision.util.InferenceDevice。
    -->
    <profiles>
        <profile>
            <id>native-win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
                <property>
                    <name>!gpu</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>ai.djl.pytorch</groupId>
                    <artifactId>pytorch-native-cpu</artifactId>
                    <version>${pytorch.native.version}</version>
                    <classifier>win-x86_64</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>native-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
                <property>
                    <name>!gpu</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>ai.djl.pytorch</groupId>
                    <artifactId>pytorch-native-cpu</artifactId>
                    <version>${pytorch.native.version}</version>
                    <classifier>linux-x86_64</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>

        <!-- ===== GPU 产物：mvn package -Dgpu=true ===== -->
        <profile>
            <id>gpu-win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
                <property>
                    <name>gpu</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <inference.flavor>cu121</inference.flavor>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>ai.djl.pytorch</groupId>
                    <artifactId>pytorch-native-cu121</artifactId>
                    <version>${pytorch.native.version}</version>
                    <classifier>${gpu.native.classifier}</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>gpu-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
                <property>
                    <name>gpu</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <inference.flavor>cu121</inference.flavor>
                <gpu.native.classifier>linux-x86_64</gpu.native.classifier>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>ai.djl.pytorch</groupId>
                    <artifactId>pytorch-native-cu121</artifactId>
                    <version>${pytorch.native.version}</version>
                    <classifier>${gpu.native.classifier}</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
