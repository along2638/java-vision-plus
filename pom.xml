        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <djl.version>0.27.0</djl.version>
        <!-- 与 pytorch-engine 0.27.0 匹配的原生库版本 -->
        <pytorch.native.version>2.1.1</pytorch.native.version>
        <!--
          推理产物类型，会被写入 classpath 下的 inference-flavor.properties，
          供启动期决策读取。默认 cpu；执行 mvn package -Dgpu=true 时变为 cu121。
          注意：torch 2.1.1 只有 cu121 这一条 CUDA 分支（cu118 最高只到 2.0.x）。
        -->
        <inference.flavor>cpu</inference.flavor>
        <!--
          GPU 产物打进去的原生库平台。默认跟随构建机，需要跨平台打包时用命令行覆盖：
            mvn package -Dgpu=true -Dgpu.native.classifier=linux-x86_64
          这样在 Windows 开发机上也能产出可直接部署到 Linux 服务器的 GPU 包。
        -->
        <gpu.native.classifier>win-x86_64</gpu.native.classifier>
        <!-- MyBatis-Plus 3.5.3.x 对应 Spring Boot 2.x（Boot 3 需改用 mybatis-plus-spring-boot3-starter） -->
        <mybatis-plus.version>3.5.3.2</mybatis-plus.version>
    </properties>
