<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置。

  规则：
    1. 控制台 + 文件双输出，文件按天 + 按大小滚动，保留 15 天（《Java 开发手册》要求全量日志 ≥ 15 天）；
    2. 每条日志都带 traceId（TraceIdFilter 写入 MDC），可按 ID 串起一次请求的全部日志；
    3. 日志目录用 LOG_HOME 环境变量覆盖，容器里挂盘即可持久化。
-->
<configuration>

    <!-- 日志目录，默认项目根目录下的 logs；容器部署用 LOG_HOME=/data/logs 覆盖 -->
    <property name="LOG_HOME" value="${LOG_HOME:-logs}"/>

    <!-- traceId 缺失时输出空串，避免出现 "null" -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-}] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/javavision.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/javavision.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>200MB</maxFileSize>
            <maxHistory>15</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- OCR 库自身日志较多，保留 info 但独立配置，便于单独调级别 -->
    <logger name="ocrLibrary" level="info" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <root level="info">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
